{
  "name": "@pinace/core",
  "version": "0.0.0",
  "description": "Pinace core SDK — types, PTB builders, read client, and policy helpers for the on-chain delegation protocol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pinace-wallet/pinace-sdk.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.cjs"
    },
    "./ptb": {
      "types": "./dist/ptb/index.d.ts",
      "import": "./dist/ptb/index.js",
      "require": "./dist/ptb/index.cjs"
    },
    "./policies": {
      "types": "./dist/policies/index.d.ts",
      "import": "./dist/policies/index.js",
      "require": "./dist/policies/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "@mysten/sui": "^2.17.0"
  },
  "devDependencies": {
    "@mysten/sui": "^2.17.0",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
